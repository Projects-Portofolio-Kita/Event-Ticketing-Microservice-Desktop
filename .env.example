# TickId Desktop Environment Configuration

# Go Microservices Backend Endpoints
# In local development with Vite dev server, requests are automatically proxied via vite.config.ts
VITE_AUTH_API_URL=/api/auth
VITE_BOOKING_API_URL=/api/booking
VITE_PAYMENT_API_URL=/api/payment

# Direct endpoints (if connecting without dev proxy or in production builds)
# VITE_AUTH_API_URL=http://localhost:8081/api/v1/auth
# VITE_BOOKING_API_URL=http://localhost:8083/api/v1
# VITE_PAYMENT_API_URL=http://localhost:8084/api/v1
